{
  "name": "ansible-vault-editor",
  "displayName": "Ansible Vault Editor",
  "description": "Encrypt, decrypt and edit Ansible Vault files and inline !vault values.",
  "version": "0.1.0",
  "publisher": "5mdt",
  "author": "Vladimir Budylnikov (@nett00n)",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/5mdt/ansible-vault-editor.git"
  },
  "bugs": {
    "url": "https://github.com/5mdt/ansible-vault-editor/issues"
  },
  "homepage": "https://github.com/5mdt/ansible-vault-editor#readme",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./build/extension.js",
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:ansible"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ansibleVault.encrypt",
        "title": "Ansible Vault: Encrypt Selection or File"
      },
      {
        "command": "ansibleVault.decrypt",
        "title": "Ansible Vault: Decrypt Block or File"
      },
      {
        "command": "ansibleVault.toggle",
        "title": "Ansible Vault: Toggle Encrypt/Decrypt"
      },
      {
        "command": "ansibleVault.encryptFile",
        "title": "Ansible Vault: Encrypt File"
      },
      {
        "command": "ansibleVault.decryptFile",
        "title": "Ansible Vault: Decrypt File"
      },
      {
        "command": "ansibleVault.toggleFile",
        "title": "Ansible Vault: Toggle Encrypt/Decrypt File",
        "icon": "$(lock)"
      },
      {
        "command": "ansibleVault.encryptAllInFile",
        "title": "Ansible Vault: Encrypt Values in File"
      },
      {
        "command": "ansibleVault.decryptAllInFile",
        "title": "Ansible Vault: Decrypt All Values in File"
      },
      {
        "command": "ansibleVault.peek",
        "title": "Ansible Vault: Peek Decrypted Value"
      },
      {
        "command": "ansibleVault.editDecrypted",
        "title": "Ansible Vault: Edit Decrypted"
      },
      {
        "command": "ansibleVault.rekey",
        "title": "Ansible Vault: Rekey"
      },
      {
        "command": "ansibleVault.rekeyWorkspace",
        "title": "Ansible Vault: Rekey Workspace"
      },
      {
        "command": "ansibleVault.toggleMarker",
        "title": "Ansible Vault: Toggle Transparent Marker"
      },
      {
        "command": "ansibleVault.forgetPasswords",
        "title": "Ansible Vault: Forget Cached Passwords"
      }
    ],
    "configuration": {
      "title": "Ansible Vault Editor",
      "properties": {
        "ansibleVault.backend": {
          "type": "string",
          "enum": [
            "native",
            "cli"
          ],
          "default": "native",
          "description": "Crypto backend used for vault operations."
        },
        "ansibleVault.cliPath": {
          "type": "string",
          "default": "ansible-vault",
          "description": "Path to the ansible-vault executable."
        },
        "ansibleVault.defaultVaultId": {
          "type": "string",
          "default": "",
          "description": "Vault ID used when none is specified."
        },
        "ansibleVault.passwordFile": {
          "type": "string",
          "default": "",
          "description": "Path to a vault password file or executable, relative to the workspace root. Overrides ANSIBLE_VAULT_PASSWORD_FILE and ansible.cfg."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "ansibleVault.encryptFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@0"
        },
        {
          "command": "ansibleVault.decryptFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@1"
        },
        {
          "command": "ansibleVault.toggleFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@2"
        }
      ],
      "editor/title": [
        {
          "command": "ansibleVault.toggleFile",
          "when": "ansibleVault.fileIsVaulted || resourceLangId =~ /^(yaml|ansible)$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ansibleVault.encrypt",
          "when": "editorTextFocus && resourceLangId =~ /^(yaml|ansible)$/",
          "group": "1_modification@1"
        },
        {
          "command": "ansibleVault.decrypt",
          "when": "editorTextFocus && resourceLangId =~ /^(yaml|ansible)$/",
          "group": "1_modification@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run lint && npm run bundle",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=build/extension.js --watch",
    "lint": "tsc -p ./ --noEmit",
    "package": "npm run bundle && vsce package --no-dependencies --readme-path extension/README.md --out build/",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:extension": "npm run compile && tsc -p tsconfig.test.json && vscode-test",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=build/extension.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "ovsx": "^1.2.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.3"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Password scripts are not run in an untrusted workspace."
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
