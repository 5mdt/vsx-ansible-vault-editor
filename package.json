{
  "name": "ansible-vault-editor",
  "displayName": "Ansible Vault Editor",
  "description": "Encrypt, decrypt and edit Ansible Vault files and inline !vault values.",
  "version": "1.0.0",
  "publisher": "5mdt",
  "icon": "extension/logo_x4.png",
  "author": "Vladimir Budylnikov (@nett00n)",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/5mdt/ansible-vault-editor.git"
  },
  "bugs": {
    "url": "https://github.com/5mdt/ansible-vault-editor/issues"
  },
  "homepage": "https://github.com/5mdt/ansible-vault-editor#readme",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./build/extension.js",
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:ansible"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ansibleVault.encrypt",
        "title": "Ansible Vault: Encrypt Selection or File"
      },
      {
        "command": "ansibleVault.decrypt",
        "title": "Ansible Vault: Decrypt Block or File"
      },
      {
        "command": "ansibleVault.toggle",
        "title": "Ansible Vault: Toggle Encrypt/Decrypt"
      },
      {
        "command": "ansibleVault.encryptFile",
        "title": "Ansible Vault: Encrypt File"
      },
      {
        "command": "ansibleVault.decryptFile",
        "title": "Ansible Vault: Decrypt File"
      },
      {
        "command": "ansibleVault.toggleFile",
        "title": "Ansible Vault: Toggle Encrypt/Decrypt File",
        "icon": "$(lock)"
      },
      {
        "command": "ansibleVault.encryptAllInFile",
        "title": "Ansible Vault: Encrypt Values in File"
      },
      {
        "command": "ansibleVault.decryptAllInFile",
        "title": "Ansible Vault: Decrypt All Values in File"
      },
      {
        "command": "ansibleVault.peek",
        "title": "Ansible Vault: Peek Decrypted Value"
      },
      {
        "command": "ansibleVault.editDecrypted",
        "title": "Ansible Vault: Edit Decrypted"
      },
      {
        "command": "ansibleVault.rekey",
        "title": "Ansible Vault: Rekey"
      },
      {
        "command": "ansibleVault.rekeyWorkspace",
        "title": "Ansible Vault: Rekey Workspace"
      },
      {
        "command": "ansibleVault.toggleMarker",
        "title": "Ansible Vault: Toggle Transparent Marker"
      },
      {
        "command": "ansibleVault.forgetPasswords",
        "title": "Ansible Vault: Forget Cached Passwords"
      },
      {
        "command": "ansibleVault.openDecryptedStagedChanges",
        "title": "Ansible Vault: Open Decrypted Staged Changes"
      },
      {
        "command": "ansibleVault.openDecryptedChanges",
        "title": "Ansible Vault: Open Decrypted Changes"
      },
      {
        "command": "ansibleVault.enableGitDiff",
        "title": "Ansible Vault: Enable Decrypted git diff"
      },
      {
        "command": "ansibleVault.disableGitDiff",
        "title": "Ansible Vault: Disable Decrypted git diff"
      }
    ],
    "configuration": {
      "title": "Ansible Vault Editor",
      "properties": {
        "ansibleVault.backend": {
          "type": "string",
          "enum": [
            "native",
            "cli"
          ],
          "default": "native",
          "description": "Crypto backend used for vault operations."
        },
        "ansibleVault.cliPath": {
          "type": "string",
          "default": "ansible-vault",
          "description": "Path to the ansible-vault executable."
        },
        "ansibleVault.defaultVaultId": {
          "type": "string",
          "default": "",
          "description": "Vault ID used when none is specified."
        },
        "ansibleVault.passwordFile": {
          "type": "string",
          "default": "",
          "description": "Path to a vault password file or executable, relative to the workspace root. Overrides ANSIBLE_VAULT_PASSWORD_FILE and ansible.cfg."
        },
        "ansibleVault.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the decrypted value when hovering a !vault block or a vaulted file's header. The CodeLens and the Peek command stay available when off."
        },
        "ansibleVault.peekExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns of files whose values are never shown by hover, CodeLens or Peek."
        },
        "ansibleVault.saveGuard": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "block"
          ],
          "default": "warn",
          "description": "What happens when a document that should be encrypted is about to be saved in plaintext: save as-is, ask (Re-encrypt and save / Save anyway / Cancel), or ask without Save anyway."
        },
        "ansibleVault.mustEncryptGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns of files that must never be saved in plaintext."
        },
        "ansibleVault.transparent": {
          "type": "boolean",
          "default": false,
          "description": "Decrypt vaulted files and values when opened and encrypt them again on save. Decrypted text then lives in the editor buffer, never on disk."
        },
        "ansibleVault.rekeyExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns of files that Rekey Workspace skips, in addition to files.exclude."
        },
        "ansibleVault.diffGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*.yml",
            "*.yaml",
            "*.vault"
          ],
          "description": "File patterns the decrypted git diff driver applies to (written to .git/info/attributes when enabled)."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "ansibleVault.encryptFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@0"
        },
        {
          "command": "ansibleVault.decryptFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@1"
        },
        {
          "command": "ansibleVault.toggleFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@2"
        }
      ],
      "editor/title": [
        {
          "command": "ansibleVault.toggleFile",
          "when": "ansibleVault.fileIsVaulted || resourceLangId =~ /^(yaml|ansible)$/",
          "group": "navigation"
        },
        {
          "command": "ansibleVault.openDecryptedChanges",
          "when": "isInDiffEditor && ansibleVault.fileIsVaulted",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ansibleVault.encrypt",
          "when": "editorTextFocus && resourceLangId =~ /^(yaml|ansible)$/",
          "group": "1_modification@1"
        },
        {
          "command": "ansibleVault.decrypt",
          "when": "editorTextFocus && resourceLangId =~ /^(yaml|ansible)$/",
          "group": "1_modification@2"
        },
        {
          "command": "ansibleVault.peek",
          "when": "editorTextFocus && (ansibleVault.inVaultBlock || ansibleVault.fileIsVaulted)",
          "group": "1_modification@3"
        },
        {
          "command": "ansibleVault.editDecrypted",
          "when": "editorTextFocus && (ansibleVault.inVaultBlock || ansibleVault.fileIsVaulted)",
          "group": "1_modification@4"
        },
        {
          "command": "ansibleVault.toggleMarker",
          "when": "editorTextFocus && resourceLangId =~ /^(yaml|ansible)$/",
          "group": "1_modification@5"
        },
        {
          "command": "ansibleVault.rekey",
          "when": "editorTextFocus && (ansibleVault.inVaultBlock || ansibleVault.fileIsVaulted)",
          "group": "1_modification@6"
        },
        {
          "command": "ansibleVault.openDecryptedChanges",
          "when": "editorTextFocus && (ansibleVault.fileIsVaulted || ansibleVault.inVaultBlock) && scmProvider == git",
          "group": "1_modification@7"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "ansibleVault.openDecryptedChanges",
          "when": "scmProvider == git && scmResourceGroup == workingTree",
          "group": "7_modification"
        },
        {
          "command": "ansibleVault.openDecryptedStagedChanges",
          "when": "scmProvider == git && scmResourceGroup == index",
          "group": "7_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "ansibleVault.openDecryptedStagedChanges",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run lint && npm run bundle",
    "watch": "esbuild src/extension.ts src/textconv.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outdir=build --watch",
    "lint": "tsc -p ./ --noEmit",
    "package": "npm run bundle && vsce package --no-dependencies --readme-path extension/README.md --baseImagesUrl https://github.com/5mdt/ansible-vault-editor/raw/HEAD/extension --out build/",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:extension": "npm run compile && tsc -p tsconfig.test.json && vscode-test",
    "bundle": "esbuild src/extension.ts src/textconv.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outdir=build"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "ovsx": "^1.2.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.3"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Password scripts are not run in an untrusted workspace."
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
